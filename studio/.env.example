# Sanity Studio config. Copy to `.env` and fill in.
# Project ID + dataset come from https://www.sanity.io/manage
SANITY_STUDIO_PROJECT_ID="your_project_id"
SANITY_STUDIO_DATASET="production"

# Only needed to run the one-time seed (npm run seed). Create an editor/deploy
# token at https://www.sanity.io/manage → API → Tokens. Do not commit it.
SANITY_AUTH_TOKEN=""
